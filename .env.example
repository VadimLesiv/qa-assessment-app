# Copy to apps/api/.env before running the API
DATABASE_URL="file:./dev.db"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Max size for uploaded .pptx files, in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# Optional - only needed for the AI features (quiz generation from cards).
# Leave unset and the app falls back to the deterministic local generator.
ANTHROPIC_API_KEY=
