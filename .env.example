# Copy to apps/api/.env before running the API
# Postgres connection string - e.g. a free Neon (neon.tech) or Supabase
# (supabase.com) project. Use one project for local dev and a separate one
# for production so seeding/resetting locally never touches deployed data.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# A second, separate Postgres database used only by `npm test` - the suite
# truncates tables between tests, so this must never point at DATABASE_URL.
# Its name must contain "test" (e.g. a Neon database named "qa_test").
TEST_DATABASE_URL="postgresql://user:password@host/dbname_test?sslmode=require"

PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Max size for uploaded .pptx files, in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# Optional - only needed for the AI features (quiz generation from cards).
# Leave unset and the app falls back to the deterministic local generator.
ANTHROPIC_API_KEY=

# Secret used to sign login tokens. Change this to a long random string for
# any real deployment; the fallback below is fine for local development only.
JWT_SECRET="dev-only-secret-change-me"
