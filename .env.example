# Copy to apps/api/.env before running the API
DATABASE_URL="file:./dev.db"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Max size for uploaded .pptx files, in bytes (default 25 MB)
MAX_UPLOAD_BYTES=26214400

# Optional - only needed for the AI features (quiz generation from cards).
# Leave unset and the app falls back to the deterministic local generator.
ANTHROPIC_API_KEY=

# Secret used to sign login tokens. Change this to a long random string for
# any real deployment; the fallback below is fine for local development only.
JWT_SECRET="dev-only-secret-change-me"
